#!/usr/bin/env python3
"""CNEX — Conserved Non-coding Element Discovery Pipeline."""
import argparse, glob, os, shutil, subprocess, sys, time
from concurrent.futures import ThreadPoolExecutor, as_completed

ROOT = os.path.dirname(os.path.abspath(__file__))
VALIDATE = os.path.join(ROOT, "bin", "validate")
ASSEMBLE = os.path.join(ROOT, "bin", "assemble")
PIGZ     = os.path.join(ROOT, "src", "pigz", "pigz")

GENOME_EXTS = (".fa", ".fa.gz", ".fasta", ".fasta.gz", ".fna", ".fna.gz")


def run(cmd, **kwargs):
    sys.stderr.write("  " + " ".join(cmd) + "\n")
    return subprocess.run(cmd, **kwargs)


def find_genomes(paths):
    files = []
    for p in paths:
        if os.path.isdir(p):
            for ext in GENOME_EXTS:
                files.extend(glob.glob(os.path.join(p, "*" + ext)))
        else:
            files.extend(glob.glob(p))
    return sorted(set(files))


def genome_name(path):
    name = os.path.basename(path)
    for ext in GENOME_EXTS:
        if name.endswith(ext):
            name = name[:-len(ext)]
            break
    # Take the first part before any dot for cleaner names
    first = name.split(".")[0]
    # If the split gives a too-short name, use the original
    return first if len(first) >= 3 else name


def check_binaries():
    missing = []
    if not os.path.exists(VALIDATE):
        missing.append("validate")
    if not os.path.exists(ASSEMBLE):
        missing.append("assemble")
    if missing:
        sys.exit("Error: C++ binaries not found: " + ", ".join(missing) +
                 "\n       Run 'make && make install' first.")


def tree_deps():
    return [
        ("FAMSA",     "famsa",
         "https://github.com/refresh-bio/FAMSA"),
        ("FastTree",  "FastTree",
         "http://www.microbesonline.org/fasttree/"),
        ("ASTRAL IV", "astral",
         "https://github.com/chaoszhang/ASTER"),
        ("ASTRAL III","",
         "https://github.com/smirarab/ASTRAL"),
    ]


def check_tree_deps():
    missing = [f"  {name}: {path}\n           Download: {url}"
               for name, path, url in tree_deps() if not os.path.exists(path)]
    if missing:
        print("Warning: phylogenetic tools not found (needed for steps 04-05):\n"
              + "\n".join(missing) + "\n", file=sys.stderr)


def process_one(genome, mers, base_dir, threads, trim, min_c=7,
                vote_frac=0.1, vote_ratio=3.0, window_size=None, step_size=None, type_=None, log_dir=None,
                keep_validate=False):
    name = genome_name(genome)
    val_dir = os.path.join(base_dir, "assemble", name)
    os.makedirs(val_dir, exist_ok=True)
    log_path = os.path.join(log_dir, name + ".log") if log_dir else os.devnull
    log = open(log_path, "w")

    val_cmd = [VALIDATE, genome, "--mers", mers, "-t", str(threads),
               "--output_dir", val_dir, "--pigz", PIGZ,
               "--min-c", str(min_c), "--vote-frac", str(vote_frac), "--vote-ratio", str(vote_ratio)]
    if type_:
        val_cmd += ["--type", type_]
    if window_size:
        val_cmd += ["--window_size", str(window_size)]
    if step_size:
        val_cmd += ["--step_size", str(step_size)]
    subprocess.run(val_cmd, stdout=log, stderr=log)

    asm_out = os.path.join(val_dir, "contigs.fa")
    asm_cmd = [ASSEMBLE, val_dir + "/", "--mers", mers, "-o", asm_out]
    if trim:
        asm_cmd.append("--trim")
    result = subprocess.run(asm_cmd, stdout=log, stderr=log)
    log.close()

    if not keep_validate:
        import glob
        for f in glob.glob(os.path.join(val_dir, "Assemble.*.reads")):
            os.remove(f)

    contigs = 0
    if os.path.exists(asm_out):
        with open(asm_out) as f:
            contigs = sum(1 for line in f if line.startswith(">"))
    return contigs, result.returncode


def cmd_validate(args):
    check_binaries()
    cmd = [VALIDATE] + args.files + [
        "--mers", args.mers,
        "-t", str(args.threads),
        "--output_dir", args.output_dir,
        "--pigz", PIGZ,
        "--min-c", str(args.min_c),
        "--vote-frac", str(args.vote_frac),
        "--vote-ratio", str(args.vote_ratio),
    ]
    if args.window_size:
        cmd += ["--window_size", str(args.window_size)]
    if args.step_size:
        cmd += ["--step_size", str(args.step_size)]
    if args.type:
        cmd += ["--type", args.type]
    return run(cmd).returncode


def cmd_assemble(args):
    check_binaries()
    cmd = [ASSEMBLE, args.input_dir,
           "--mers", args.mers,
           "-o", args.output]
    if args.kmer:
        cmd += ["-k", str(args.kmer)]
    if args.min_c:
        cmd += ["--min-c", str(args.min_c)]
    if args.min_count:
        cmd += ["--min-count", str(args.min_count)]
    if args.max_reads:
        cmd += ["--max-reads", str(args.max_reads)]
    if args.max_loci_gap:
        cmd += ["--max-loci-gap", str(args.max_loci_gap)]
    if not args.no_trim:
        cmd.append("--trim")
    return run(cmd).returncode


def cmd_pipeline(args):
    check_binaries()
    genomes = find_genomes(args.files)
    if not genomes:
        sys.exit("Error: no genome files found in " + ", ".join(args.files))

    os.makedirs(args.output_dir, exist_ok=True)

    mers = args.mers
    if args.cne:
        filtered = os.path.join(args.output_dir, "msa.filtered.fa")
        subprocess.run(["python3", os.path.join(ROOT, "src", "00.filter_msa.py"),
                        args.cne, "--min-species", "8", "--min-avg-len", "50", "-o", filtered])
        mers = os.path.join(args.output_dir, "mers_table.tsv")
        subprocess.run([os.path.join(ROOT, "bin", "mertable"),
                        filtered, "-k", "13", "-c", "4", "-o", mers])

    trim = not args.no_trim

    n = len(genomes)
    print(f"Processing {n} genome{'s' if n != 1 else ''} ({args.jobs} jobs, {args.threads} threads each)...")
    log_dir = os.path.join(args.output_dir, "logs")
    os.makedirs(log_dir, exist_ok=True)

    with ThreadPoolExecutor(max_workers=args.jobs) as pool:
        futures = {}
        for genome in genomes:
            name = genome_name(genome)
            f = pool.submit(process_one, genome, mers, args.output_dir, args.threads, trim,
                            args.min_c, args.vote_frac, args.vote_ratio,
                            args.window_size, args.step_size, args.type, log_dir,
                            keep_validate=getattr(args, 'keep_validate', False))
            futures[f] = name

        for f in as_completed(futures):
            contigs, rc = f.result()
            status = "✓" if rc == 0 else "✗"
            print(f"  {status}  {futures[f]:<30} {contigs:>6} contigs")

    check_tree_deps()


def main():
    parser = argparse.ArgumentParser(description="CNEX — Conserved Non-coding Element Discovery Pipeline")
    parser.add_argument("--version", action="version", version="CNEX 1.0")

    sub = parser.add_subparsers(dest="command")

    # ─── validate ───
    p_val = sub.add_parser("validate", help="Validate reads or genome against confident k-mers")
    p_val.add_argument("files", nargs="+", help="Input files (FASTQ or FASTA, plain or .gz)")
    p_val.add_argument("--mers", required=True, help="Confident k-mer table")
    p_val.add_argument("-t", "--threads", type=int, default=8, help="Threads per file (default: 8)")
    p_val.add_argument("-o", "--output-dir", default="out", help="Output directory (default: out)")
    p_val.add_argument("--type", choices=["genome", "fastq"],
                       help="Input type (auto-detected if omitted)")
    p_val.add_argument("--min-c", type=int, default=7, help="Min colinear k-mer matches (default: 7)")
    p_val.add_argument("--vote-frac", type=float, default=0.1, help="Vote fraction (default: 0.1)")
    p_val.add_argument("--vote-ratio", type=float, default=3.0, help="Vote ratio (default: 3.0)")
    p_val.add_argument("--window-size", type=int, help="Genome sliding window size (default: 150)")
    p_val.add_argument("--step-size", type=int, help="Genome sliding window step (default: 25)")

    # ─── assemble ───
    p_asm = sub.add_parser("assemble", help="De Bruijn assembly from validated reads")
    p_asm.add_argument("input_dir", help="Directory with Assemble.*.reads files")
    p_asm.add_argument("--mers", required=True, help="Confident k-mer table")
    p_asm.add_argument("-o", "--output", default="assembled.fasta", help="Output FASTA (default: assembled.fasta)")
    p_asm.add_argument("-k", "--kmer", type=int, default=35, help="K-mer length (default: 35)")
    p_asm.add_argument("--min-c", type=int, default=3, help="Min k-mer matches for validation (default: 3)")
    p_asm.add_argument("--min-count", type=int, default=2, help="Min (k+1)-mer occurrence (default: 2)")
    p_asm.add_argument("--max-reads", type=int, default=200, help="Max reads per element/locus (default: 200)")
    p_asm.add_argument("--max-loci-gap", type=int, default=5000,
                       help="Max gap for locus clustering in genome mode (default: 5000)")
    p_asm.add_argument("--no-trim", action="store_true", dest="no_trim",
                       help="Disable contig trimming (trimming enabled by default)")

    # ─── pipeline ───
    p_pipe = sub.add_parser("pipeline",
                            help="Run validate + assemble on multiple genomes")
    p_pipe.add_argument("files", nargs="+",
                        help="Input genome directories, files, or glob patterns (e.g. genomes/*.fa)")
    p_pipe.add_argument("--cne", help="Start from MSA file (runs 00+01 then 02+03)")
    p_pipe.add_argument("--mers", help="Start from existing k-mer table (runs 02+03)")
    p_pipe.add_argument("-t", "--threads", type=int, default=8, help="Threads per genome (default: 8)")
    p_pipe.add_argument("-j", "--jobs", type=int, default=4, help="Parallel genomes (default: 4)")
    p_pipe.add_argument("-o", "--output-dir", default="out", help="Output root directory (default: out)")
    p_pipe.add_argument("--no-trim", action="store_true", dest="no_trim",
                        help="Disable contig trimming")
    p_pipe.add_argument("--type", choices=["genome", "fastq"],
                        help="Input type (auto-detected if omitted)")
    p_pipe.add_argument("--window-size", type=int, help="Sliding window size (default: 150)")
    p_pipe.add_argument("--step-size", type=int, help="Sliding window step (default: 25)")
    p_pipe.add_argument("--min-c", type=int, default=7, help="Min colinear k-mer matches (default: 7)")
    p_pipe.add_argument("--vote-frac", type=float, default=0.1, help="Vote fraction (default: 0.1)")
    p_pipe.add_argument("--vote-ratio", type=float, default=3.0, help="Vote ratio (default: 3.0)")
    p_pipe.add_argument("--keep-validate", action="store_true",
                        help="Keep intermediate validate output (Assemble.*.reads)")

    # ─── setup ───
    p_setup = sub.add_parser("setup", help="Check dependencies and build instructions")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 1

    if args.command == "validate":
        return cmd_validate(args)
    elif args.command == "assemble":
        return cmd_assemble(args)
    elif args.command == "pipeline":
        return cmd_pipeline(args)
    elif args.command == "setup":
        items = [
            ("validate", VALIDATE, None),
            ("assemble", ASSEMBLE, None),
            ("pigz",     PIGZ,     "make -C src/pigz"),
        ]
        for name, path, hint in tree_deps():
            items.append((name, path, hint))

        print("CNEX Environment Setup\n")
        for name, path, hint in items:
            ok = os.path.exists(path) or (path and shutil.which(path))
            mark = "✓" if ok else " "
            print(f"  [{mark}] {name:<12} {path}")
            if not ok and hint:
                print(f"       {hint}")
        print("\nSee README.md for details.")
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
